{
  "name": "photoai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "bun run --cwd apps/web db:generate",
    "db:migrate": "bun run --cwd apps/web db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
