# Copy to .env at the repo root and fill in. Never commit .env.

# Neon Postgres connection string
NEON_DB_URL=

# Better Auth: secret is any long random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google login: Google Cloud Console > Clients > Web application
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
